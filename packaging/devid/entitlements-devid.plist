<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Edición de tienda firmada con Developer ID (descarga directa), sin sandbox y con
         Hardened Runtime. Python carga extensiones .so que no son de Apple y usa memoria
         ejecutable (ctypes/libffi): sin estas dos excepciones la app no arranca. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
