# ========================
# EDF Catálogo de Tablas
# Archivo de ejemplo (.env.example)
# Copia este archivo como .env y rellena los valores reales.
# Lista de variables verificada contra el código (config.py, app/, tools/).
# ========================

# Flask
FLASK_ENV=development
SECRET_KEY=__cámbiame_por_una_clave_segura__
# Alias legacy de SECRET_KEY usado por algún script suelto; mantenlo igual a SECRET_KEY
FLASK_SECRET_KEY=__cámbiame_por_una_clave_segura__

# MongoDB
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB=app_catalogojoyero_nueva

# Brevo (SMTP) - opcional
BREVO_API_KEY=
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=

# Correo clásico (si no usas Brevo API)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER_NAME=
MAIL_DEFAULT_SENDER_EMAIL=
MAIL_DEFAULT_SENDER=

# Notificaciones (opcional)
NOTIFICATION_EMAIL_1=
NOTIFICATION_EMAIL_2=

# AWS S3 (imágenes de catálogos)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET_NAME=edf-catalogo-tablas
USE_S3=false

# Google Drive (backups) / Gemini (opcionales)
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_REDIRECT_URI=http://localhost:5005/auth/google/callback
GOOGLE_DRIVE_FOLDER=Backups_CatalogoTablas

# Monitoreo / logs
DISABLE_MONITORING=false
LOG_DIR=logs

# Zona horaria
TZ=Europe/Madrid

# Python
PYTHONPATH=.
